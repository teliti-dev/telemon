{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Telemon",
  "version": "0.1.0",
  "identifier": "dev.teliti.telemon",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../dist": "ui"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMUQxNUQwNDUwRDVBQUMKUldTc1dnMUYwQlVkNjdjaWQ1eGZCR25NV3ZCdUJpYXhJeWdQTGIzR2hPWFhIUjRRbjc5N1lxN2MK",
      "endpoints": [
        "https://github.com/teliti-dev/telemon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
