{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Telemon",
  "version": "0.1.0",
  "identifier": "dev.teliti.telemon",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../dist": "ui"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "publisher": "Teliti",
    "copyright": "Copyright © 2026 Teliti (https://teliti.net/). Licensed under AGPL-3.0.",
    "homepage": "https://teliti.net/",
    "license": "AGPL-3.0-only",
    "licenseFile": "installer/license.txt",
    "category": "Utility",
    "shortDescription": "Monitor PPPoE users and events across MikroTik routers",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "installer/installer.nsi"
      }
    },
    "longDescription": "Telemon reads each MikroTik router over the RouterOS API and shows who is connected, who is inactive or disabled, and what just happened (auth failed, authenticated, connected, disconnected). The router stays the source of truth. Share the dashboard to browsers on your network, and add features with extensions. Free software under the AGPL-3.0, provided without warranty."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMUQxNUQwNDUwRDVBQUMKUldTc1dnMUYwQlVkNjdjaWQ1eGZCR25NV3ZCdUJpYXhJeWdQTGIzR2hPWFhIUjRRbjc5N1lxN2MK",
      "endpoints": [
        "https://github.com/teliti-dev/telemon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
